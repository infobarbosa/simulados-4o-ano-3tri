   "titulo": "Comparativo de palavras curtas",
   "icone": "📏",
   "pagina": "69",
   "blocos": [
    {
     "tipo": "texto",
     "texto": "Para comparar duas coisas com um adjetivo curto, acrescentamos -er ao adjetivo e usamos than, que quer dizer \"do que\"."
    },
    {
     "tipo": "exemplos",
     "itens": [
      {
       "frase": "tall, taller",
       "nota": "alto, mais alto"
      },
      {
       "frase": "Ana is taller than Rui.",
       "nota": "Ana é mais alta do que Rui."
      }
     ]
    },
    {
     "tipo": "dica",
     "texto": "Com adjetivo curto, não se usa more junto: o -er já faz esse trabalho."
    }
   ]
  },
  "more": {
   "titulo": "Comparativo com more",
   "icone": "➕",
   "pagina": "69",
   "blocos": [
    {
     "tipo": "texto",
     "texto": "Com adjetivos longos, não acrescentamos -er. Usamos more antes do adjetivo e than depois."
    },
    {
     "tipo": "exemplos",
     "itens": [
      {
       "frase": "beautiful, more beautiful",
       "nota": "bonito, mais bonito"
      },
      {
       "frase": "This park is more beautiful than that park.",
       "nota": "Este parque é mais bonito do que aquele."
      }
     ]
    },
    {
     "tipo": "dica",
     "texto": "Palavra longa: more antes. Palavra curta: -er no fim."
    }
   ]
  },
